@* クラスの名前空間を指定する(C#と同じ) *@
@using CmpSystem.Presentations.ViewModels
@* View が受け取るデータ型（ViewModel）を宣言asp-for はこの型のプロパティと結びつける *@
@model List<EmployeeSearchViewModel> // SampleFormのリストをModelとして受け取る（型を明示）
@{
    ViewData["Title"] = "部署一覧";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>
@foreach (var employee in Model)
{
    <tr>
        <td>@employee.Name</td />
        <td>@employee.Email</td >
        <td>@employee.DeptName</td>
    </tr>
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-4 col-sm-6">
        </div>
    </div>
</div>