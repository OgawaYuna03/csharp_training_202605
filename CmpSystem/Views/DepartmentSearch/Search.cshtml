@* クラスの名前空間を指定する(C#と同じ) *@
@using CmpSystem.Presentations.ViewModels
@* View が受け取るデータ型（ViewModel）を宣言asp-for はこの型のプロパティと結びつける *@
@model List<DepartmentSearchViewModel> // SampleFormのリストをModelとして受け取る（型を明示）
@{
    ViewData["Title"] = "部署一覧";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <table class="text-center table">
            <tr>
                <th>部署ID</th>
                <th>部長名</th>
                <th>部署名</th>
            </tr>
            @foreach (var department in Model)
            {
                <tr>

                    <td>@department.DeptId</td>
                    <td>@department.Chief</td>
                    <td>@department.DeptName</td><br />

                </tr>
            }
        </table>
        <div class="text-center mt-4">
            <a asp-action="Index" asp-controller="Home" class="btn btn-primary mt-3">
                Home
            </a>
        </div>

    </div>
</div>