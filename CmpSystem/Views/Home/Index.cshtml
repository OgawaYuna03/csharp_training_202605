@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="Title">CmpSystem</h1>
    <div class="d-flex justify-content-center align-items-center gap-3" style="height:300px;">
        <div class="text-center mt-10">
            <a asp-action="Search" asp-controller="EmployeeSearch" method="get"
               class="btn btn-info py-3 px-5">従業員一覧</a>
            <a asp-action="Search" asp-controller="DepartmentSearch" method="get"
               class="btn btn-danger py-3 px-5">部署一覧</a>
            <br>
            <br>
            <a asp-action="Enter" asp-controller="EmployeeRegister" method="get"
               class="btn btn-primary py-3 px-5">従業員登録</a>
            <a asp-action="Enter" asp-controller="DepartmentRegister" method="get"
               class="btn btn-warning py-3 px-5">部署登録</a>
        </div>
    </div>
</div>